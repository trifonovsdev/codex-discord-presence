<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexPresence.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Codex Presence">

    <Grid x:Name="RootLayout" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Codex Presence"
            Subtitle=""
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            AutomationProperties.Name="Codex Presence title bar">
            <TitleBar.LeftHeader>
                <Image
                    Width="18"
                    Height="18"
                    Margin="4,0,0,0"
                    Source="presence-mark.png"
                    Stretch="Uniform"
                    AutomationProperties.AccessibilityView="Raw" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="0,1,0,1">
            <Grid Padding="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Agents followed by the service; the filled chip owns the Discord card. -->
                <StackPanel
                    x:Name="AgentSwitcher"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6"
                    AutomationProperties.Name="Followed agents">
                    <Border x:Name="CodexChip" Style="{StaticResource ChipBorderStyle}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,16,16" />
                                </Grid.Clip>
                                <Image
                                    Width="21"
                                    Height="21"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="codex-app-icon.png"
                                    Stretch="Uniform" />
                            </Grid>
                            <TextBlock
                                x:Name="CodexChipLabel"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Codex" />
                            <Ellipse
                                x:Name="CodexChipDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ClaudeChip" Style="{StaticResource ChipBorderStyle}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,16,16" />
                                </Grid.Clip>
                                <Image
                                    Width="21"
                                    Height="21"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="claude-code-icon.png"
                                    Stretch="Uniform" />
                            </Grid>
                            <TextBlock
                                x:Name="ClaudeChipLabel"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Claude Code" />
                            <Ellipse
                                x:Name="ClaudeChipDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button
                        x:Name="DiagnosticsButton"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Click="DiagnosticsButton_Click"
                        AutomationProperties.HelpText="Checks the local service, Discord, Codex and Claude Code hooks, and SSH workspaces"
                        AutomationProperties.Name="Run diagnostics"
                        ToolTipService.ToolTip="Run diagnostics">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE9D9;" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Click="SettingsButton_Click"
                        AutomationProperties.HelpText="Changes agents, activity names, privacy, startup, appearance, and SSH workspaces"
                        AutomationProperties.Name="Open settings"
                        ToolTipService.ToolTip="Open settings">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE713;" />
                    </Button>
                    <Button
                        x:Name="PauseButton"
                        MinWidth="136"
                        Style="{StaticResource CompactButtonStyle}"
                        Click="PauseButton_Click"
                        AutomationProperties.Name="Pause presence">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="PauseIcon" FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE769;" />
                            <TextBlock x:Name="PauseButtonText" FontSize="12" Text="Pause presence" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,22,28,22">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                x:Name="ConnectionDot"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource TextMutedBrush}" />
                            <TextBlock
                                x:Name="ConnectionStatus"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Connecting"
                                AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SharingSummary"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Text="Sharing project · file · timer" />
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Spacing="4">
                        <TextBlock
                            x:Name="ProjectName"
                            Style="{StaticResource DisplayTitleTextStyle}"
                            Text="Waiting for an agent"
                            AutomationProperties.LiveSetting="Polite" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="CurrentFile"
                                VerticalAlignment="Center"
                                MaxLines="1"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="No activity yet"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="CopyStatus"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Grid.Column="1"
                                Margin="10,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SuccessBrush}"
                                Text="Copied"
                                AutomationProperties.LiveSetting="Polite" />
                            <Button
                                x:Name="CopyPathButton"
                                Grid.Column="2"
                                Width="34"
                                Height="34"
                                MinWidth="34"
                                MinHeight="34"
                                Padding="0"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Click="CopyPathButton_Click"
                                IsEnabled="False"
                                AutomationProperties.Name="Copy current file path"
                                ToolTipService.ToolTip="Copy current file path">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="DISCORD PREVIEW" />
                        <TextBlock
                            x:Name="PreviewLabel"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Text="Not published" />
                    </Grid>

                    <Border
                        x:Name="DiscordPreview"
                        MinHeight="112"
                        Margin="0,10,0,0"
                        Padding="18,16"
                        Background="{ThemeResource DiscordCanvasBrush}"
                        BorderBrush="{ThemeResource DiscordDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        AutomationProperties.Name="Discord activity preview">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="52" Height="52" VerticalAlignment="Center">
                                <Border Background="{ThemeResource DiscordSurfaceBrush}" CornerRadius="10" />
                                <!-- Both artworks share a 544 px grid, so one overscan fits either agent. -->
                                <Grid x:Name="PreviewIconViewport" Width="52" Height="52">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,52,52" />
                                    </Grid.Clip>
                                    <Image
                                        x:Name="PreviewCodexIcon"
                                        Width="68"
                                        Height="68"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="codex-app-icon.png"
                                        Stretch="Uniform"
                                        AutomationProperties.Name="Official Codex app icon" />
                                    <Image
                                        x:Name="PreviewClaudeIcon"
                                        Width="68"
                                        Height="68"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="claude-code-icon.png"
                                        Stretch="Uniform"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Claude Code icon" />
                                </Grid>
                                <Ellipse
                                    x:Name="PreviewStatusDot"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,-2,-2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource TextMutedBrush}"
                                    Stroke="{ThemeResource DiscordCanvasBrush}"
                                    StrokeThickness="3" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="PreviewTitle"
                                    MaxLines="1"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource DiscordTextBrush}"
                                    Text="Coding with Codex"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PreviewPrimaryLine"
                                    MaxLines="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource DiscordTextBrush}"
                                    Text="Working in Codex"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PreviewSecondaryLine"
                                    MaxLines="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource DiscordMutedBrush}"
                                    Text="Active Codex session"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border
                                x:Name="PreviewTimerRow"
                                Grid.Column="2"
                                Padding="9,4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DiscordSurfaceBrush}"
                                CornerRadius="11">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#7CC49A" />
                                    <TextBlock
                                        x:Name="PreviewElapsed"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="11"
                                        Foreground="{ThemeResource DiscordTextBrush}"
                                        Text="00:00:00" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Margin="0,22,0,0" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Agent" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="AgentValue" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Activity source" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="SourceValue" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Workspace" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="WorkspaceValue" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="Session" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="SessionValue" FontSize="13" FontFamily="{StaticResource MonoFontFamily}" />
                        </StackPanel>
                    </Grid>
                    <InfoBar
                        x:Name="WarningBar"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning"
                        Title="Presence needs attention"
                        AutomationProperties.LiveSetting="Assertive">
                        <InfoBar.ActionButton>
                            <Button
                                Style="{StaticResource CompactButtonStyle}"
                                Click="DiagnosticsButton_Click"
                                AutomationProperties.Name="Open Doctor for this warning"
                                Content="Open Doctor" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="False" Severity="Informational"
                             Title="Updating Codex Presence" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite">
                        <ProgressBar x:Name="UpdateDownloadProgress" IsIndeterminate="True" Margin="0,8,0,0" />
                    </InfoBar>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            Background="{ThemeResource CanvasBrush}"
            BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextMutedBrush}"
                    Text="Runs quietly in your tray · No telemetry" />
                <TextBlock
                    x:Name="FooterVersion"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFontFamily}"
                    FontSize="10"
                    Foreground="{ThemeResource TextMutedBrush}"
                    Text="v2.6.0" />
            </Grid>
        </Border>
    </Grid>
</Window>
