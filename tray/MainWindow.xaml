<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexPresence.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Codex Presence">

    <Grid x:Name="RootLayout" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="43" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Codex Presence"
            Subtitle=""
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            AutomationProperties.Name="Codex Presence title bar">
            <TitleBar.LeftHeader>
                <Grid Width="18" Height="18" Margin="4,0,0,0">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,18,18" />
                    </Grid.Clip>
                    <Image
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="codex-app-icon.png"
                        Stretch="Uniform" />
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="0,1,0,1">
            <Grid Padding="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Presence" />
                    <TextBlock Foreground="{ThemeResource TextMutedBrush}" Text="/" />
                    <TextBlock
                        x:Name="ActivityContext"
                        MaxWidth="230"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="Session monitor · Local desktop"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button
                        x:Name="DiagnosticsButton"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Click="DiagnosticsButton_Click"
                        AutomationProperties.HelpText="Checks the local service, Discord, Codex hooks, and SSH workspaces"
                        AutomationProperties.Name="Run diagnostics"
                        ToolTipService.ToolTip="Run diagnostics">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE9D9;" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Click="SettingsButton_Click"
                        AutomationProperties.HelpText="Changes activity name, privacy, startup, language, and SSH workspaces"
                        AutomationProperties.Name="Open settings"
                        ToolTipService.ToolTip="Open settings">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE713;" />
                    </Button>
                    <Button
                        x:Name="PauseButton"
                        Style="{StaticResource CompactButtonStyle}"
                        Click="PauseButton_Click"
                        AutomationProperties.Name="Pause presence">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="PauseIcon" FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE769;" />
                            <TextBlock x:Name="PauseButtonText" FontSize="12" Text="Pause presence" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="20,14,20,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                x:Name="ConnectionDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource TextMutedBrush}" />
                            <TextBlock
                                x:Name="ConnectionStatus"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Connecting"
                                AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SharingSummary"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Text="Sharing project · file · timer" />
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Spacing="3">
                        <TextBlock
                            x:Name="ProjectName"
                            MaxLines="1"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="Waiting for Codex"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.LiveSetting="Polite" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="CurrentFile"
                                VerticalAlignment="Center"
                                MaxLines="1"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="No activity yet"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="CopyStatus"
                                Grid.Column="1"
                                Margin="10,0,5,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SuccessBrush}"
                                Text="Copied"
                                Visibility="Collapsed"
                                AutomationProperties.LiveSetting="Polite" />
                            <Button
                                x:Name="CopyPathButton"
                                Grid.Column="2"
                                Width="26"
                                Height="26"
                                MinWidth="26"
                                MinHeight="26"
                                Padding="0"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Click="CopyPathButton_Click"
                                IsEnabled="False"
                                AutomationProperties.Name="Copy current file path"
                                ToolTipService.ToolTip="Copy current file path">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <InfoBar
                        x:Name="WarningBar"
                        Margin="0,11,0,0"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning"
                        Title="Presence needs attention"
                        AutomationProperties.LiveSetting="Assertive">
                        <InfoBar.ActionButton>
                            <Button
                                Style="{StaticResource CompactButtonStyle}"
                                Click="DiagnosticsButton_Click"
                                AutomationProperties.Name="Open Doctor for this warning"
                                Content="Open Doctor" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Discord preview" />
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" Text="LIVE CARD" />
                    </Grid>

                    <Border
                        x:Name="DiscordPreview"
                        Height="82"
                        Margin="0,8,0,0"
                        Padding="12"
                        Background="{ThemeResource DiscordCanvasBrush}"
                        BorderBrush="{ThemeResource DiscordDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        AutomationProperties.Name="Discord activity preview">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="42" Height="42" VerticalAlignment="Center">
                                <Border Background="{ThemeResource DiscordSurfaceBrush}" CornerRadius="9" />
                                <Grid x:Name="PreviewIconViewport" Width="42" Height="42">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,42,42" />
                                    </Grid.Clip>
                                    <Image
                                        Width="54"
                                        Height="54"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="codex-app-icon.png"
                                        Stretch="Uniform"
                                        AutomationProperties.Name="Official Codex app icon" />
                                </Grid>
                                <Ellipse
                                    x:Name="PreviewStatusDot"
                                    Width="11"
                                    Height="11"
                                    Margin="0,0,-1,-1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource TextMutedBrush}"
                                    Stroke="{ThemeResource DiscordCanvasBrush}"
                                    StrokeThickness="3" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    x:Name="PreviewTitle"
                                    MaxLines="1"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource DiscordTextBrush}"
                                    Text="Coding with Codex"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PreviewPrimaryLine"
                                    MaxLines="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource DiscordTextBrush}"
                                    Text="Working in Codex"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PreviewSecondaryLine"
                                    MaxLines="1"
                                    FontSize="11"
                                    Foreground="{ThemeResource DiscordMutedBrush}"
                                    Text="Active Codex session"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                x:Name="PreviewTimerRow"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource SuccessBrush}" />
                                <TextBlock
                                    x:Name="PreviewElapsed"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    Foreground="{ThemeResource SuccessBrush}"
                                    Text="00:00:00" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="SourceValue" />
                        <TextBlock x:Name="WorkspaceValue" />
                        <TextBlock x:Name="SessionValue" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextMutedBrush}"
                    Text="Closing keeps Presence running in the notification area." />
                <TextBlock
                    x:Name="FooterVersion"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="10"
                    Foreground="{ThemeResource TextMutedBrush}"
                    Text="v2.4.3" />
            </Grid>
        </Border>
    </Grid>
</Window>
