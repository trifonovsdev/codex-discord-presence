<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexPresence.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexPresence"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <!--
                    WinUI resolves control brushes from the nearest theme dictionary, so the
                    clay switches and input accents are scoped to this window's theme.
                -->
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#B55536" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#A14A2E" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#8F4128" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#B55536" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#A14A2E" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#8F4128" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8A877E" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#65635C" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#65635C" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#65635C" />
                        <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F0EEE6" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E8E6DC" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F5F4ED" />
                        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D6D2C4" />
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#C4BFAE" />
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#D6D2C4" />
                        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#E8E6DC" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#B55536" />
                        <SolidColorBrush x:Key="ComboBoxForeground" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#3D3D3A" />
                        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#65635C" />
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#3D3D3A" />
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#65635C" />
                        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D6D2C4" />
                        <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#B55536" />
                        <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#F0EEE6" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#E8E6DC" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#F6E7DF" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#F6E7DF" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#F0EEE6" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#E8E6DC" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedDisabled" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#3D3D3A" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#65635C" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#141413" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#3D3D3A" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedDisabled" Color="#65635C" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="#F0EEE6" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="#E8E6DC" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushDisabled" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="#F6E7DF" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedUnfocused" Color="#F6E7DF" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="#F0EEE6" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="#E8E6DC" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedDisabled" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="TextControlForeground" Color="#141413" />
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#141413" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#141413" />
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#65635C" />
                        <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F0EEE6" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F5F4ED" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D6D2C4" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#C4BFAE" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B55536" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#E8E6DC" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#65635C" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#3D3D3A" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#65635C" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#65635C" />
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#B55536" />
                        <Color x:Key="ToggleSwitchFillOffPointerOver">#F0EEE6</Color>
                        <Color x:Key="ToggleSwitchFillOffPressed">#E8E6DC</Color>
                        <Color x:Key="ToggleSwitchStrokeOffPointerOver">#65635C</Color>
                        <Color x:Key="ToggleSwitchStrokeOffPressed">#65635C</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#D97757" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E08A6D" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#CE6F50" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#D97757" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#E08A6D" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#CE6F50" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#302F2C" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8E8B82" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1F1E1D" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1F1E1D" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#1F1E1D" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#CFCCC2" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#CFCCC2" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#CFCCC2" />
                        <SolidColorBrush x:Key="ComboBoxBackground" Color="#302F2C" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#393835" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#42413D" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#302F2C" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#1F1E1D" />
                        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#4D4B46" />
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#5E5C56" />
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#4D4B46" />
                        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#3A3935" />
                        <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#D97757" />
                        <SolidColorBrush x:Key="ComboBoxForeground" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#CFCCC2" />
                        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#A9A69C" />
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#CFCCC2" />
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#A9A69C" />
                        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B2A27" />
                        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#4D4B46" />
                        <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#D97757" />
                        <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#2B2A27" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#393835" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#42413D" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="#2B2A27" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#3D2D26" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#3D2D26" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#393835" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#42413D" />
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedDisabled" Color="#2B2A27" />
                        <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#CFCCC2" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#A9A69C" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#CFCCC2" />
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedDisabled" Color="#A9A69C" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrush" Color="#2B2A27" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="#393835" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="#42413D" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushDisabled" Color="#2B2A27" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="#3D2D26" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedUnfocused" Color="#3D2D26" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="#393835" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="#42413D" />
                        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedDisabled" Color="#2B2A27" />
                        <SolidColorBrush x:Key="TextControlForeground" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F5F4EF" />
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#A9A69C" />
                        <SolidColorBrush x:Key="TextControlBackground" Color="#302F2C" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#393835" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#302F2C" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#1F1E1D" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#4D4B46" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5E5C56" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#D97757" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#3A3935" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A9A69C" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#CFCCC2" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A9A69C" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#A9A69C" />
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#D97757" />
                        <Color x:Key="ToggleSwitchFillOffPointerOver">#393835</Color>
                        <Color x:Key="ToggleSwitchFillOffPressed">#42413D</Color>
                        <Color x:Key="ToggleSwitchStrokeOffPointerOver">#A9A69C</Color>
                        <Color x:Key="ToggleSwitchStrokeOffPressed">#A9A69C</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast" />
                </ResourceDictionary.ThemeDictionaries>

                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

                <Style x:Key="SettingsPageHeaderStyle" TargetType="StackPanel">
                    <Setter Property="Spacing" Value="4" />
                </Style>

                <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
                    <Setter Property="FontSize" Value="26" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="LineHeight" Value="32" />
                </Style>

                <Style x:Key="SettingsGroupTitleStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="CharacterSpacing" Value="60" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                </Style>

                <Style x:Key="SettingsRowContainerStyle" TargetType="Border">
                    <Setter Property="MinHeight" Value="56" />
                    <Setter Property="Padding" Value="0,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>

                <Style x:Key="SettingsRowLayoutStyle" TargetType="Grid">
                    <Setter Property="ColumnSpacing" Value="18" />
                </Style>

                <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>

                <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="LineHeight" Value="16" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>

                <ControlTemplate x:Key="SettingsNavButtonTemplate" TargetType="RadioButton">
                    <Border
                        x:Name="NavRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.CustomVisualStateManager>
                            <local:InteractionStateManager />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="InteractionContent.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="NavRail.Opacity" Value="0" />
                                        <Setter Target="NavSelection.Opacity" Value="0" />
                                        <Setter Target="InteractionContent.Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="NavSelection.Opacity" Value="1" />
                                        <Setter Target="NavRail.Opacity" Value="1" />
                                        <Setter Target="InteractionContent.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="NavSelection" Background="{ThemeResource SurfaceHoverBrush}" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="HoverSurface" Background="{ThemeResource SurfaceHoverBrush}" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressedSurface" Background="{ThemeResource SurfacePressedBrush}" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Border
                                x:Name="NavRail"
                                Width="2"
                                Height="16"
                                Margin="1,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentBrush}"
                                CornerRadius="1"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="InteractionContent"
                                Margin="13,0,8,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>

                <Style x:Key="SettingsNavButtonStyle" TargetType="RadioButton">
                    <Setter Property="Height" Value="34" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                    <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusStrokeBrush}" />
                    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CanvasBrush}" />
                    <Setter Property="Template" Value="{StaticResource SettingsNavButtonTemplate}" />
                </Style>

                <!-- Keep native thumb travel, pointer/keyboard states and reduced motion. -->
                <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="Width" Value="40" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="OnContent" Value="" />
                    <Setter Property="OffContent" Value="" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusStrokeBrush}" />
                    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CanvasBrush}" />
                </Style>

                <Style
                    x:Key="SettingsComboBoxItemStyle"
                    TargetType="ComboBoxItem"
                    BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="CornerRadius" Value="5" />
                    <Setter Property="FontSize" Value="12" />
                </Style>

                <Style
                    x:Key="SettingsInputStyle"
                    TargetType="ComboBox"
                    BasedOn="{StaticResource DefaultComboBoxStyle}">
                    <Setter Property="Width" Value="196" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="MaxHeight" Value="34" />
                    <Setter Property="Padding" Value="11,5,34,5" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
                </Style>

                <Style
                    x:Key="SettingsTextBoxStyle"
                    TargetType="TextBox"
                    BasedOn="{StaticResource DefaultTextBoxStyle}">
                    <Setter Property="Width" Value="196" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="MaxHeight" Value="34" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="FontSize" Value="12" />
                </Style>

                <Style
                    x:Key="SettingsInlineTextBoxStyle"
                    TargetType="TextBox"
                    BasedOn="{StaticResource DefaultTextBoxStyle}">
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="MaxHeight" Value="30" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="5" />
                    <Setter Property="FontSize" Value="11" />
                </Style>

                <Style
                    x:Key="SettingsFooterButtonStyle"
                    TargetType="Button"
                    BasedOn="{StaticResource CompactButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Codex Presence"
            Subtitle="Settings"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <Image
                    Width="18"
                    Height="18"
                    Margin="4,0,0,0"
                    Source="presence-mark.png"
                    Stretch="Uniform"
                    AutomationProperties.AccessibilityView="Raw" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SettingsSidebar"
                Grid.Column="0"
                Background="{ThemeResource CanvasBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="0,1,1,0">
                <StackPanel Padding="12,16,12,0" Spacing="4">
                    <TextBlock
                        Margin="8,0,0,9"
                        Foreground="{ThemeResource TextMutedBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="Settings" />
                    <RadioButton GroupName="SettingsSections"
                        x:Name="GeneralNavButton"
                        AutomationProperties.Name="General settings"
                        Checked="SectionButtonChecked"
                        Content="General"
                        IsChecked="True"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="general" />
                    <RadioButton GroupName="SettingsSections"
                        x:Name="AgentsNavButton"
                        AutomationProperties.Name="Agent settings"
                        Checked="SectionButtonChecked"
                        Content="Agents"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="agents" />
                    <RadioButton GroupName="SettingsSections"
                        x:Name="PrivacyNavButton"
                        AutomationProperties.Name="Privacy settings"
                        Checked="SectionButtonChecked"
                        Content="Privacy"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="privacy" />
                    <RadioButton GroupName="SettingsSections"
                        x:Name="RemoteNavButton"
                        AutomationProperties.Name="SSH settings"
                        Checked="SectionButtonChecked"
                        Content="SSH workspaces"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="remote" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ScrollViewer
                        x:Name="GeneralPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Border Padding="24,20,24,24">
                            <StackPanel Spacing="17">
                                <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                    <TextBlock Text="General" Style="{StaticResource SettingsPageTitleStyle}" />
                                    <TextBlock
                                        Text="Presence, startup, and update behavior."
                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="PRESENCE" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Discord presence" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Publish activity while Codex or Claude Code is working." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="PresenceToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Discord presence"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="APPLICATION" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Launch at sign in" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Keep presence ready after Windows starts." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="StartupToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Launch at sign in"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Automatic updates" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Check verified releases once a day." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="UpdatesToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Automatic updates"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Appearance" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Ivory, slate, or follow Windows." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="AppearanceSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Appearance"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Card language" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Language used in Discord." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="LanguageSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Card language"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="AgentsPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <Border Padding="24,20,24,24">
                            <StackPanel Spacing="17">
                                <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                    <TextBlock Text="Agents" Style="{StaticResource SettingsPageTitleStyle}" />
                                    <TextBlock
                                        Text="Choose which coding agents appear on your Discord card."
                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="CLAUDE CODE" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Follow Claude Code" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Terminal, IDE, and Claude Desktop sessions." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="ClaudeToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Follow Claude Code"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Activity name" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Title shown while Claude Code is active." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="ClaudeActivityNameInput"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Claude Code activity name"
                                                MaxLength="128"
                                                PlaceholderText="Coding with Claude Code"
                                                Style="{StaticResource SettingsTextBoxStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Instant updates" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Adds lightweight hooks to Claude Code settings." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="ClaudeHooksToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Claude Code hooks"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="SSH workspaces" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Look for Claude Code on your SSH hosts too." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="ClaudeRemoteToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Follow Claude Code over SSH"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Idle after" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Clear the card when a session goes quiet." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="ClaudeIdleSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Claude Code idle timeout"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="CODEX" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Follow Codex" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="The task selected in ChatGPT/Codex Desktop." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="CodexToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Follow Codex"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Activity name" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Title shown while Codex is active." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="ActivityNameInput"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Codex activity name"
                                                MaxLength="128"
                                                PlaceholderText="Coding with Codex"
                                                Style="{StaticResource SettingsTextBoxStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="BOTH ACTIVE" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Show on the card" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Most recent follows your latest prompt." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="PreferredAgentSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Agent shown when both are active"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="PrivacyPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <Border Padding="24,20,24,24">
                            <StackPanel Spacing="17">
                                <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                    <TextBlock Text="Privacy" Style="{StaticResource SettingsPageTitleStyle}" />
                                    <TextBlock
                                        Text="Choose exactly what Discord receives."
                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="PRESET" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Privacy preset" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Apply a sensible sharing baseline." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="PresetSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Privacy preset"
                                                SelectionChanged="PresetSelectionChanged"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="SHARED DETAILS" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Task title" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Share the Codex task or Claude Code session title." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="TaskTitleToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Share task title"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Project name" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Share the active workspace." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="ProjectToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Share project name"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Edited file" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Share the latest edited file." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="FileToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Share edited file"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Session timer" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="One timer per agent session." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="TimerToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Share session timer"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="File display" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Filename or repository-relative path." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="FileModeSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="File display mode"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="RemotePage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <Border Padding="24,20,24,24">
                            <StackPanel Spacing="17">
                                <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                    <TextBlock Text="SSH workspaces" Style="{StaticResource SettingsPageTitleStyle}" />
                                    <TextBlock
                                        Text="Follow Codex and Claude Code sessions on remote machines."
                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="WORKSPACES" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border
                                        Background="{ThemeResource SurfaceBrush}"
                                        BorderBrush="{ThemeResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Padding="11,8"
                                                Background="{ThemeResource SurfaceRaisedBrush}"
                                                BorderBrush="{ThemeResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                CornerRadius="6,6,0,0">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.05*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="1.8*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Name" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                    <TextBlock Grid.Column="1" Text="User@host" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                    <TextBlock Grid.Column="2" Text="Workspace roots" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="1" MinHeight="164">
                                                <ListView
                                                    x:Name="RemoteList"
                                                    Padding="5"
                                                    HorizontalContentAlignment="Stretch"
                                                    SelectionMode="Single"
                                                    AutomationProperties.Name="SSH workspaces">
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="MinHeight" Value="42" />
                                                            <Setter Property="Padding" Value="5,4" />
                                                            <Setter Property="CornerRadius" Value="5" />
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.05*" />
                                                                    <ColumnDefinition Width="1.4*" />
                                                                    <ColumnDefinition Width="1.8*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox
                                                                    AutomationProperties.Name="Workspace name"
                                                                    PlaceholderText="Remote"
                                                                    Style="{StaticResource SettingsInlineTextBoxStyle}"
                                                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    AutomationProperties.Name="SSH user and host"
                                                                    PlaceholderText="dev@example.com"
                                                                    Style="{StaticResource SettingsInlineTextBoxStyle}"
                                                                    Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBox
                                                                    Grid.Column="2"
                                                                    AutomationProperties.Name="Workspace roots"
                                                                    PlaceholderText="/srv/store; ~/work"
                                                                    Style="{StaticResource SettingsInlineTextBoxStyle}"
                                                                    Text="{Binding Roots, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>

                                                <StackPanel
                                                    x:Name="RemoteEmptyState"
                                                    Width="300"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    Spacing="3">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        Text="No SSH workspaces"
                                                        Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock
                                                        Text="Add one to follow remote Codex and Claude Code sessions."
                                                        TextAlignment="Center"
                                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button
                                            x:Name="AddRemoteButton"
                                            AutomationProperties.Name="Add SSH workspace"
                                            Click="AddRemoteClicked"
                                            Content="Add"
                                            Style="{StaticResource CompactButtonStyle}" />
                                        <Button
                                            x:Name="RemoveRemoteButton"
                                            AutomationProperties.Name="Remove selected SSH workspace"
                                            Click="RemoveRemoteClicked"
                                            Content="Remove"
                                            Style="{StaticResource CompactButtonStyle}" />
                                        <Button
                                            x:Name="TestRemoteButton"
                                            AutomationProperties.Name="Test selected SSH workspace"
                                            Click="TestRemoteClicked"
                                            Content="Test SSH"
                                            Style="{StaticResource CompactButtonStyle}" />
                                        <Button
                                            x:Name="InstallRemoteButton"
                                            AutomationProperties.Name="Install helper on selected SSH workspace"
                                            Click="InstallRemoteClicked"
                                            Content="Install helper"
                                            Style="{StaticResource CompactButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="2,9,0,0"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ProgressRing
                                            x:Name="RemoteProgress"
                                            Width="16"
                                            Height="16"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="RemoteActionStatus"
                                            VerticalAlignment="Center"
                                            AutomationProperties.LiveSetting="Polite"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            Style="{StaticResource SettingsRowDescriptionStyle}"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="MONITORING" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Refresh interval" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="How often the remote task is checked." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="PollIntervalSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Remote refresh interval"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <Border
                    x:Name="SettingsFooter"
                    Grid.Row="1"
                    Padding="24,12"
                    Background="{ThemeResource CanvasBrush}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Changes apply after saving."
                            Style="{StaticResource SettingsRowDescriptionStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="CancelButton"
                                AutomationProperties.Name="Cancel settings changes"
                                Click="CancelClicked"
                                Content="Cancel"
                                Style="{StaticResource SettingsFooterButtonStyle}" />
                            <Button
                                x:Name="SaveButton"
                                MinHeight="34"
                                Padding="14,5"
                                AutomationProperties.Name="Save settings changes"
                                Click="SaveClicked"
                                Content="Save changes"
                                CornerRadius="8"
                                FontSize="12"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
