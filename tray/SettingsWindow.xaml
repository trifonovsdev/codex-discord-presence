<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexPresence.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="SettingsSectionStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="SettingsPageHeaderStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="3" />
            </Style>

            <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-12" />
            </Style>

            <Style x:Key="SettingsRowStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="Padding" Value="16,7" />
            </Style>

            <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsInputStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="176" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
                <Setter Property="Width" Value="224" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Codex Presence"
            Subtitle="Settings"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <Grid Width="18" Height="18" Margin="4,0,0,0">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,18,18" />
                    </Grid.Clip>
                    <Image
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="codex-app-icon.png"
                        Stretch="Uniform" />
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        <NavigationView
            x:Name="SettingsNavigation"
            Grid.Row="1"
            AlwaysShowHeader="False"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="NavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" IsSelected="True" Tag="general" />
                <NavigationViewItem Content="Privacy" Tag="privacy" />
                <NavigationViewItem Content="SSH" Tag="remote" />
            </NavigationView.MenuItems>

            <Grid Background="Transparent">
                <ScrollViewer
                    x:Name="GeneralPage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Border
                        MaxWidth="700"
                        Padding="24,16,24,28"
                        HorizontalAlignment="Center"
                        Background="Transparent">
                        <StackPanel Spacing="16">
                            <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                <TextBlock Text="General" Style="{StaticResource SettingsPageTitleStyle}" />
                                <TextBlock
                                    Text="Startup, updates, and how your Discord presence behaves."
                                    Style="{StaticResource SettingsRowDescriptionStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsSectionStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Discord presence" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Publish activity while Codex is open." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="PresenceToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsToggleStyle}"
                                            AutomationProperties.Name="Discord presence" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Activity name" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Title shown above the project and file in Discord." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <TextBox
                                            x:Name="ActivityNameInput"
                                            Grid.Column="1"
                                            MaxLength="128"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsTextBoxStyle}"
                                            AutomationProperties.Name="Discord activity name"
                                            PlaceholderText="Coding with Codex" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Launch at sign in" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Keep presence available after Windows starts." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="StartupToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsToggleStyle}"
                                            AutomationProperties.Name="Launch at sign in" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Automatic updates" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Check verified GitHub releases once a day." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="UpdatesToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsToggleStyle}"
                                            AutomationProperties.Name="Automatic updates" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Card language" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Language of the text published to Discord." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="LanguageSelect"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Card language"
                                            Style="{StaticResource SettingsInputStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="PrivacyPage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <Border
                        MaxWidth="700"
                        Padding="24,16,24,28"
                        HorizontalAlignment="Center"
                        Background="Transparent">
                        <StackPanel Spacing="16">
                            <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                <TextBlock Text="Privacy" Style="{StaticResource SettingsPageTitleStyle}" />
                                <TextBlock
                                    Text="Choose exactly which Codex signals Discord receives."
                                    Style="{StaticResource SettingsRowDescriptionStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsSectionStyle}">
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="Privacy preset" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock Text="Quick baseline; task titles always require explicit opt-in." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="PresetSelect"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Privacy preset"
                                        SelectionChanged="PresetSelectionChanged"
                                        Style="{StaticResource SettingsInputStyle}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsSectionStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Task title" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Share the selected Codex task title when available." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="TaskTitleToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsToggleStyle}"
                                            AutomationProperties.Name="Share task title" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Project name" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Share the active workspace on your Discord card." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="ProjectToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsToggleStyle}"
                                            AutomationProperties.Name="Share project name" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Edited file" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Share the latest file touched in the selected task." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="FileToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsToggleStyle}"
                                            AutomationProperties.Name="Share edited file" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Session timer" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Use one stable timer for the whole Codex session." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="TimerToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsToggleStyle}"
                                            AutomationProperties.Name="Share session timer" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="File display" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Filename only or repository-relative path." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="FileModeSelect"
                                            Grid.Column="1"
                                            AutomationProperties.Name="File display mode"
                                            Style="{StaticResource SettingsInputStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="RemotePage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <Border
                        MaxWidth="720"
                        Padding="24,16,24,28"
                        HorizontalAlignment="Center"
                        Background="Transparent">
                        <StackPanel Spacing="16">
                            <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                <TextBlock Text="SSH workspaces" Style="{StaticResource SettingsPageTitleStyle}" />
                                <TextBlock
                                    Text="Map remote roots to servers. The most specific root wins."
                                    Style="{StaticResource SettingsRowDescriptionStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Padding="0" Style="{StaticResource SettingsSectionStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Padding="14,9"
                                        Background="{ThemeResource SurfaceRaisedBrush}"
                                        CornerRadius="9,9,0,0">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.45*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Name" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            <TextBlock Grid.Column="1" Text="User@host" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            <TextBlock Grid.Column="2" Text="Workspace roots (; separated)" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" MinHeight="190">
                                        <ListView
                                            x:Name="RemoteList"
                                            Padding="6"
                                            HorizontalContentAlignment="Stretch"
                                            SelectionMode="Single"
                                            AutomationProperties.Name="SSH workspaces">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="MinHeight" Value="50" />
                                                    <Setter Property="Padding" Value="6,5" />
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="1.45*" />
                                                            <ColumnDefinition Width="2*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            MinHeight="36"
                                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="Remote"
                                                            AutomationProperties.Name="Workspace name" />
                                                        <TextBox
                                                            Grid.Column="1"
                                                            MinHeight="36"
                                                            Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="dev@example.com"
                                                            AutomationProperties.Name="SSH user and host" />
                                                        <TextBox
                                                            Grid.Column="2"
                                                            MinHeight="36"
                                                            Text="{Binding Roots, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="/srv/store; ~/work"
                                                            AutomationProperties.Name="Workspace roots" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <StackPanel
                                            x:Name="RemoteEmptyState"
                                            Width="320"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Spacing="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="28"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                Glyph="&#xE968;" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Text="No SSH workspaces yet"
                                                Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock
                                                Text="Add one to follow remote Codex tasks."
                                                TextAlignment="Center"
                                                Style="{StaticResource SettingsRowDescriptionStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="AddRemoteButton"
                                        Content="Add"
                                        Click="AddRemoteClicked"
                                        Style="{StaticResource CompactButtonStyle}"
                                        AutomationProperties.Name="Add SSH workspace" />
                                    <Button
                                        x:Name="RemoveRemoteButton"
                                        Content="Remove"
                                        Click="RemoveRemoteClicked"
                                        Style="{StaticResource CompactButtonStyle}"
                                        AutomationProperties.Name="Remove selected SSH workspace" />
                                    <Button
                                        x:Name="TestRemoteButton"
                                        Content="Test SSH"
                                        Click="TestRemoteClicked"
                                        Style="{StaticResource CompactButtonStyle}"
                                        AutomationProperties.Name="Test selected SSH workspace" />
                                    <Button
                                        x:Name="InstallRemoteButton"
                                        Content="Install helper"
                                        Click="InstallRemoteClicked"
                                        Style="{StaticResource CompactButtonStyle}"
                                        AutomationProperties.Name="Install helper on selected SSH workspace" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Margin="2,12,0,0"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <ProgressRing
                                        x:Name="RemoteProgress"
                                        Width="18"
                                        Height="18"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="RemoteActionStatus"
                                        VerticalAlignment="Center"
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        Style="{StaticResource SettingsRowDescriptionStyle}"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SettingsSectionStyle}">
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="Refresh interval" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock Text="How often the selected remote task is checked." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="PollIntervalSelect"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Remote refresh interval"
                                        Style="{StaticResource SettingsInputStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Border
            Grid.Row="2"
            Padding="20,10"
            Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Style="{StaticResource SettingsRowDescriptionStyle}"
                    Text="Changes apply after saving." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CancelButton"
                        Content="Cancel"
                        Click="CancelClicked"
                        Style="{StaticResource CompactButtonStyle}"
                        AutomationProperties.Name="Cancel settings changes" />
                    <Button
                        x:Name="SaveButton"
                        Content="Save changes"
                        Click="SaveClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinHeight="32"
                        Padding="14,5"
                        CornerRadius="6"
                        FontSize="12"
                        AutomationProperties.Name="Save settings changes" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
