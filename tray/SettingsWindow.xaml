<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexPresence.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceHoverBrush" />
                <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderStrongBrush" />
                <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="FocusStrokeBrush" />
                <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="BorderStrongBrush" />
                <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderBrush" />
                <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="FocusStrokeBrush" />
                <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxForegroundPressed" ResourceKey="TextSecondaryBrush" />
                <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="TextMutedBrush" />
                <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TextSecondaryBrush" />
                <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="TextMutedBrush" />
                <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderStrongBrush" />
                <StaticResource x:Key="ComboBoxDropDownForeground" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxItemPillFillBrush" ResourceKey="AccentBrush" />
                <StaticResource x:Key="ComboBoxItemBackground" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="SurfaceHoverBrush" />
                <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxItemBackgroundDisabled" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxItemBackgroundSelectedUnfocused" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="SurfaceHoverBrush" />
                <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxItemBackgroundSelectedDisabled" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="TextSecondaryBrush" />
                <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="TextMutedBrush" />
                <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxItemForegroundSelectedUnfocused" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="TextSecondaryBrush" />
                <StaticResource x:Key="ComboBoxItemForegroundSelectedDisabled" ResourceKey="TextMutedBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrush" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrushPointerOver" ResourceKey="SurfaceHoverBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrushPressed" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrushDisabled" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrushSelected" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrushSelectedUnfocused" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPointerOver" ResourceKey="SurfaceHoverBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPressed" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="ComboBoxItemBorderBrushSelectedDisabled" ResourceKey="SurfaceBrush" />

                <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="TextMutedBrush" />
                <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceHoverBrush" />
                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceRaisedBrush" />
                <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SurfaceBrush" />
                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderStrongBrush" />
                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="FocusStrokeBrush" />
                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="FocusStrokeBrush" />
                <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderBrush" />
                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextMutedBrush" />
                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextSecondaryBrush" />
                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextSecondaryBrush" />
                <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="TextMutedBrush" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

                <Style x:Key="SettingsPageHeaderStyle" TargetType="StackPanel">
                    <Setter Property="Spacing" Value="2" />
                </Style>

                <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                    <Setter Property="FontSize" Value="19" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="CharacterSpacing" Value="-10" />
                    <Setter Property="LineHeight" Value="24" />
                </Style>

                <Style x:Key="SettingsGroupTitleStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="CharacterSpacing" Value="24" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </Style>

                <Style x:Key="SettingsRowContainerStyle" TargetType="Border">
                    <Setter Property="MinHeight" Value="56" />
                    <Setter Property="Padding" Value="0,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>

                <Style x:Key="SettingsRowLayoutStyle" TargetType="Grid">
                    <Setter Property="ColumnSpacing" Value="18" />
                </Style>

                <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>

                <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="LineHeight" Value="15" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>

                <ControlTemplate x:Key="SettingsNavButtonTemplate" TargetType="RadioButton">
                    <Border
                        x:Name="NavRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="NavRoot.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="NavRoot.Opacity" Value="0.82" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="NavRoot.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="NavRail.Opacity" Value="0" />
                                        <Setter Target="NavSelection.Opacity" Value="0" />
                                        <Setter Target="NavLabel.Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="NavSelection.Opacity" Value="1" />
                                        <Setter Target="NavRail.Opacity" Value="1" />
                                        <Setter Target="NavLabel.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="NavSelection" Background="{ThemeResource SurfaceRaisedBrush}" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Border
                                x:Name="NavRail"
                                Width="2"
                                Height="16"
                                Margin="1,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentBrush}"
                                CornerRadius="1"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="NavLabel"
                                Margin="13,0,8,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>

                <Style x:Key="SettingsNavButtonStyle" TargetType="RadioButton">
                    <Setter Property="Height" Value="34" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                    <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusStrokeBrush}" />
                    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CanvasBrush}" />
                    <Setter Property="Template" Value="{StaticResource SettingsNavButtonTemplate}" />
                </Style>

                <!-- Keep native thumb travel, pointer/keyboard states and reduced motion. -->
                <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="Width" Value="40" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="OnContent" Value="" />
                    <Setter Property="OffContent" Value="" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusStrokeBrush}" />
                    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CanvasBrush}" />
                </Style>

                <Style
                    x:Key="SettingsComboBoxItemStyle"
                    TargetType="ComboBoxItem"
                    BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="CornerRadius" Value="5" />
                    <Setter Property="FontSize" Value="12" />
                </Style>

                <Style
                    x:Key="SettingsInputStyle"
                    TargetType="ComboBox"
                    BasedOn="{StaticResource DefaultComboBoxStyle}">
                    <Setter Property="Width" Value="196" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="MaxHeight" Value="32" />
                    <Setter Property="Padding" Value="11,5,34,5" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
                </Style>

                <Style
                    x:Key="SettingsTextBoxStyle"
                    TargetType="TextBox"
                    BasedOn="{StaticResource DefaultTextBoxStyle}">
                    <Setter Property="Width" Value="196" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="MaxHeight" Value="32" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="FontSize" Value="12" />
                </Style>

                <Style
                    x:Key="SettingsInlineTextBoxStyle"
                    TargetType="TextBox"
                    BasedOn="{StaticResource DefaultTextBoxStyle}">
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="MaxHeight" Value="30" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="5" />
                    <Setter Property="FontSize" Value="11" />
                </Style>

                <Style
                    x:Key="SettingsFooterButtonStyle"
                    TargetType="Button"
                    BasedOn="{StaticResource CompactButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Codex Presence"
            Subtitle="Settings"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <Grid Width="18" Height="18" Margin="4,0,0,0">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,18,18" />
                    </Grid.Clip>
                    <Image
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="codex-app-icon.png"
                        Stretch="Uniform" />
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="144" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SettingsSidebar"
                Grid.Column="0"
                Background="{ThemeResource CanvasBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="0,1,1,0">
                <StackPanel Padding="12,16,12,0" Spacing="4">
                    <TextBlock
                        Margin="8,0,0,9"
                        Foreground="{ThemeResource TextMutedBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="Settings" />
                    <RadioButton GroupName="SettingsSections"
                        x:Name="GeneralNavButton"
                        AutomationProperties.Name="General settings"
                        Checked="SectionButtonChecked"
                        Content="General"
                        IsChecked="True"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="general" />
                    <RadioButton GroupName="SettingsSections"
                        x:Name="PrivacyNavButton"
                        AutomationProperties.Name="Privacy settings"
                        Checked="SectionButtonChecked"
                        Content="Privacy"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="privacy" />
                    <RadioButton GroupName="SettingsSections"
                        x:Name="RemoteNavButton"
                        AutomationProperties.Name="SSH settings"
                        Checked="SectionButtonChecked"
                        Content="SSH"
                        Style="{StaticResource SettingsNavButtonStyle}"
                        Tag="remote" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ScrollViewer
                        x:Name="GeneralPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Border Padding="24,20,24,24">
                            <StackPanel Spacing="17">
                                <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                    <TextBlock Text="General" Style="{StaticResource SettingsPageTitleStyle}" />
                                    <TextBlock
                                        Text="Presence, startup, and update behavior."
                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Presence" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Discord presence" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Publish activity while Codex is open." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="PresenceToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Discord presence"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Activity name" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Title shown on your Discord card." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="ActivityNameInput"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Discord activity name"
                                                MaxLength="128"
                                                PlaceholderText="Coding with Codex"
                                                Style="{StaticResource SettingsTextBoxStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Application" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Launch at sign in" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Keep presence ready after Windows starts." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="StartupToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Launch at sign in"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Automatic updates" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Check verified releases once a day." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="UpdatesToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Automatic updates"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Card language" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Language used in Discord." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="LanguageSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Card language"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="PrivacyPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <Border Padding="24,20,24,24">
                            <StackPanel Spacing="17">
                                <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                    <TextBlock Text="Privacy" Style="{StaticResource SettingsPageTitleStyle}" />
                                    <TextBlock
                                        Text="Choose exactly what Discord receives."
                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Preset" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Privacy preset" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Apply a sensible sharing baseline." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="PresetSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Privacy preset"
                                                SelectionChanged="PresetSelectionChanged"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Shared details" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Task title" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Share the selected Codex task title." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="TaskTitleToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Share task title"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Project name" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Share the active workspace." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="ProjectToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Share project name"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Edited file" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Share the latest edited file." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="FileToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Share edited file"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Session timer" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Use one timer for the Codex session." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="TimerToggle"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Share session timer"
                                                Style="{StaticResource SettingsToggleStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="File display" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Filename or repository-relative path." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="FileModeSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="File display mode"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="RemotePage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <Border Padding="24,20,24,24">
                            <StackPanel Spacing="17">
                                <StackPanel Style="{StaticResource SettingsPageHeaderStyle}">
                                    <TextBlock Text="SSH workspaces" Style="{StaticResource SettingsPageTitleStyle}" />
                                    <TextBlock
                                        Text="Follow Codex sessions running on remote machines."
                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Workspaces" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border
                                        Background="{ThemeResource SurfaceBrush}"
                                        BorderBrush="{ThemeResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Padding="11,8"
                                                Background="{ThemeResource SurfaceRaisedBrush}"
                                                BorderBrush="{ThemeResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                CornerRadius="6,6,0,0">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.05*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="1.8*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Name" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                    <TextBlock Grid.Column="1" Text="User@host" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                    <TextBlock Grid.Column="2" Text="Workspace roots" Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="1" MinHeight="164">
                                                <ListView
                                                    x:Name="RemoteList"
                                                    Padding="5"
                                                    HorizontalContentAlignment="Stretch"
                                                    SelectionMode="Single"
                                                    AutomationProperties.Name="SSH workspaces">
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="MinHeight" Value="42" />
                                                            <Setter Property="Padding" Value="5,4" />
                                                            <Setter Property="CornerRadius" Value="5" />
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.05*" />
                                                                    <ColumnDefinition Width="1.4*" />
                                                                    <ColumnDefinition Width="1.8*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox
                                                                    AutomationProperties.Name="Workspace name"
                                                                    PlaceholderText="Remote"
                                                                    Style="{StaticResource SettingsInlineTextBoxStyle}"
                                                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    AutomationProperties.Name="SSH user and host"
                                                                    PlaceholderText="dev@example.com"
                                                                    Style="{StaticResource SettingsInlineTextBoxStyle}"
                                                                    Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBox
                                                                    Grid.Column="2"
                                                                    AutomationProperties.Name="Workspace roots"
                                                                    PlaceholderText="/srv/store; ~/work"
                                                                    Style="{StaticResource SettingsInlineTextBoxStyle}"
                                                                    Text="{Binding Roots, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>

                                                <StackPanel
                                                    x:Name="RemoteEmptyState"
                                                    Width="300"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    Spacing="3">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        Text="No SSH workspaces"
                                                        Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock
                                                        Text="Add one to follow a remote Codex session."
                                                        TextAlignment="Center"
                                                        Style="{StaticResource SettingsRowDescriptionStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button
                                            x:Name="AddRemoteButton"
                                            AutomationProperties.Name="Add SSH workspace"
                                            Click="AddRemoteClicked"
                                            Content="Add"
                                            Style="{StaticResource CompactButtonStyle}" />
                                        <Button
                                            x:Name="RemoveRemoteButton"
                                            AutomationProperties.Name="Remove selected SSH workspace"
                                            Click="RemoveRemoteClicked"
                                            Content="Remove"
                                            Style="{StaticResource CompactButtonStyle}" />
                                        <Button
                                            x:Name="TestRemoteButton"
                                            AutomationProperties.Name="Test selected SSH workspace"
                                            Click="TestRemoteClicked"
                                            Content="Test SSH"
                                            Style="{StaticResource CompactButtonStyle}" />
                                        <Button
                                            x:Name="InstallRemoteButton"
                                            AutomationProperties.Name="Install helper on selected SSH workspace"
                                            Click="InstallRemoteClicked"
                                            Content="Install helper"
                                            Style="{StaticResource CompactButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="2,9,0,0"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ProgressRing
                                            x:Name="RemoteProgress"
                                            Width="16"
                                            Height="16"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="RemoteActionStatus"
                                            VerticalAlignment="Center"
                                            AutomationProperties.LiveSetting="Polite"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            Style="{StaticResource SettingsRowDescriptionStyle}"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="Monitoring" Style="{StaticResource SettingsGroupTitleStyle}" />
                                    <Border Style="{StaticResource SettingsRowContainerStyle}">
                                        <Grid Style="{StaticResource SettingsRowLayoutStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Refresh interval" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="How often the remote task is checked." Style="{StaticResource SettingsRowDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="PollIntervalSelect"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Remote refresh interval"
                                                Style="{StaticResource SettingsInputStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <Border
                    x:Name="SettingsFooter"
                    Grid.Row="1"
                    Padding="24,12"
                    Background="{ThemeResource CanvasBrush}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Changes apply after saving."
                            Style="{StaticResource SettingsRowDescriptionStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="CancelButton"
                                AutomationProperties.Name="Cancel settings changes"
                                Click="CancelClicked"
                                Content="Cancel"
                                Style="{StaticResource SettingsFooterButtonStyle}" />
                            <Button
                                x:Name="SaveButton"
                                MinHeight="32"
                                Padding="14,5"
                                AutomationProperties.Name="Save settings changes"
                                Click="SaveClicked"
                                Content="Save changes"
                                CornerRadius="6"
                                FontSize="12"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
