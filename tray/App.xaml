<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CodexPresence.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexPresence"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- One quiet black theme; contrast colors remain user-controlled. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#0B0C0D" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F20B0C0D" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#111214" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#161719" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1C1D20" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#24262A" />
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#34363B" />

                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2EF" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A5A6A3" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#92938F" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#F0F0EC" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="#DCDDD8" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B0C0D" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#5FD49B" />
                    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#142B22" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#D8AE62" />
                    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#2D2416" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#EC7777" />
                    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#321C20" />
                    <SolidColorBrush x:Key="FocusStrokeBrush" Color="#A7A8A4" />

                    <SolidColorBrush x:Key="DiscordCanvasBrush" Color="#101113" />
                    <SolidColorBrush x:Key="DiscordSurfaceBrush" Color="#191A1D" />
                    <SolidColorBrush x:Key="DiscordTextBrush" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="DiscordMutedBrush" Color="#A9ADB5" />
                    <SolidColorBrush x:Key="DiscordDividerBrush" Color="#292B30" />

                    <!-- App-owned keys avoid WinUI Button* resources shadowed in control/theme scopes. -->
                    <SolidColorBrush x:Key="PresenceButtonBackground" Color="#161719" />
                    <SolidColorBrush x:Key="PresenceButtonBackgroundPointerOver" Color="#222428" />
                    <SolidColorBrush x:Key="PresenceButtonBackgroundPressed" Color="#292C32" />
                    <SolidColorBrush x:Key="PresenceButtonBackgroundDisabled" Color="#101113" />
                    <SolidColorBrush x:Key="PresenceButtonForeground" Color="#F2F2EF" />
                    <SolidColorBrush x:Key="PresenceButtonForegroundPointerOver" Color="#F2F2EF" />
                    <SolidColorBrush x:Key="PresenceButtonForegroundPressed" Color="#F2F2EF" />
                    <SolidColorBrush x:Key="PresenceButtonForegroundDisabled" Color="#5F605E" />
                    <SolidColorBrush x:Key="PresenceButtonBorderBrush" Color="#34363B" />
                    <SolidColorBrush x:Key="PresenceButtonBorderBrushPointerOver" Color="#484C55" />
                    <SolidColorBrush x:Key="PresenceButtonBorderBrushPressed" Color="#555A65" />
                    <SolidColorBrush x:Key="PresenceButtonBorderBrushDisabled" Color="#202226" />

                    <SolidColorBrush x:Key="PresenceAccentButtonBackground" Color="#F0F0EC" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBackgroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBackgroundPressed" Color="#DCDDD8" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBackgroundDisabled" Color="#454C46" />
                    <SolidColorBrush x:Key="PresenceAccentButtonForeground" Color="#0B0C0D" />
                    <SolidColorBrush x:Key="PresenceAccentButtonForegroundPointerOver" Color="#0B0C0D" />
                    <SolidColorBrush x:Key="PresenceAccentButtonForegroundPressed" Color="#0B0C0D" />
                    <SolidColorBrush x:Key="PresenceAccentButtonForegroundDisabled" Color="#8C958D" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBorderBrush" Color="#F0F0EC" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBorderBrushPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBorderBrushPressed" Color="#DCDDD8" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBorderBrushDisabled" Color="#454C46" />
                    <!-- Native off-state animations consume Color resources, not Brush resources. -->
                    <Color x:Key="ToggleSwitchFillOffPointerOver">#222428</Color>
                    <Color x:Key="ToggleSwitchFillOffPressed">#292C32</Color>
                    <Color x:Key="ToggleSwitchStrokeOffPointerOver">#92938F</Color>
                    <Color x:Key="ToggleSwitchStrokeOffPressed">#A5A6A3</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="FocusStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush x:Key="DiscordCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DiscordSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="DiscordTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DiscordMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DiscordDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush x:Key="PresenceButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PresenceButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PresenceButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PresenceButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PresenceButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="PresenceButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PresenceButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="PresenceButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />

                    <SolidColorBrush x:Key="PresenceAccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PresenceAccentButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <StaticResource x:Key="ToggleSwitchFillOffPointerOver" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="ToggleSwitchFillOffPressed" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="ToggleSwitchStrokeOffPointerOver" ResourceKey="SystemColorHighlightColor" />
                    <StaticResource x:Key="ToggleSwitchStrokeOffPressed" ResourceKey="SystemColorHighlightColor" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="BaseTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}" />

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="36" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="22" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="21" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="17" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>

            <Style x:Key="EyebrowTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="55" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>

            <Style x:Key="MonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="SurfaceRaisedBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOff" ResourceKey="BorderStrongBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="AccentTextBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="AccentTextBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="AccentTextBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPressed" ResourceKey="TextSecondaryBrush" />


            <ControlTemplate x:Key="SurfaceButtonTemplate" TargetType="Button">
                <Grid x:Name="ButtonRoot" Background="Transparent" Control.IsTemplateFocusTarget="True">
                    <VisualStateManager.CustomVisualStateManager>
                        <local:InteractionStateManager />
                    </VisualStateManager.CustomVisualStateManager>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="InteractionContent.Foreground" Value="{ThemeResource PresenceButtonForegroundPointerOver}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="InteractionContent.Foreground" Value="{ThemeResource PresenceButtonForegroundPressed}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="InteractionContent.Foreground" Value="{ThemeResource PresenceButtonForegroundDisabled}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <!-- The base never fades or swaps brushes. Each state has its own surface. -->
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False" />
                    <Border
                        x:Name="HoverSurface"
                        Background="{ThemeResource PresenceButtonBackgroundPointerOver}"
                        BorderBrush="{ThemeResource PresenceButtonBorderBrushPointerOver}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        Opacity="0" />
                    <Border
                        x:Name="PressedSurface"
                        Background="{ThemeResource PresenceButtonBackgroundPressed}"
                        BorderBrush="{ThemeResource PresenceButtonBorderBrushPressed}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        Opacity="0" />
                    <Border
                        x:Name="DisabledSurface"
                        Background="{ThemeResource PresenceButtonBackgroundDisabled}"
                        BorderBrush="{ThemeResource PresenceButtonBorderBrushDisabled}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        Opacity="0" />
                    <ContentPresenter
                        x:Name="InteractionContent"
                        AutomationProperties.AccessibilityView="Raw"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        Foreground="{TemplateBinding Foreground}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="AccentSurfaceButtonTemplate" TargetType="Button">
                <Grid x:Name="ButtonRoot" Background="Transparent" Control.IsTemplateFocusTarget="True">
                    <VisualStateManager.CustomVisualStateManager>
                        <local:InteractionStateManager />
                    </VisualStateManager.CustomVisualStateManager>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="InteractionContent.Foreground" Value="{ThemeResource PresenceAccentButtonForegroundPointerOver}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="InteractionContent.Foreground" Value="{ThemeResource PresenceAccentButtonForegroundPressed}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="InteractionContent.Foreground" Value="{ThemeResource PresenceAccentButtonForegroundDisabled}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <!-- The base never fades or swaps brushes. Each state has its own surface. -->
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False" />
                    <Border
                        x:Name="HoverSurface"
                        Background="{ThemeResource PresenceAccentButtonBackgroundPointerOver}"
                        BorderBrush="{ThemeResource PresenceAccentButtonBorderBrushPointerOver}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        Opacity="0" />
                    <Border
                        x:Name="PressedSurface"
                        Background="{ThemeResource PresenceAccentButtonBackgroundPressed}"
                        BorderBrush="{ThemeResource PresenceAccentButtonBorderBrushPressed}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        Opacity="0" />
                    <Border
                        x:Name="DisabledSurface"
                        Background="{ThemeResource PresenceAccentButtonBackgroundDisabled}"
                        BorderBrush="{ThemeResource PresenceAccentButtonBorderBrushDisabled}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        Opacity="0" />
                    <ContentPresenter
                        x:Name="InteractionContent"
                        AutomationProperties.AccessibilityView="Raw"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        Foreground="{TemplateBinding Foreground}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>

            <Style x:Key="BaseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Template" Value="{StaticResource SurfaceButtonTemplate}" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusStrokeBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CanvasBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Template" Value="{StaticResource AccentSurfaceButtonTemplate}" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,8" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusStrokeBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CanvasBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="11,4" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
